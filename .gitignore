# Large data files (use Git LFS if needed)
*.h5ad
*.h5
*.pkl
*.pickle

# Temporary files
*.tmp
*.log
*~
.DS_Store

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.venv/
venv/

